# Secrets must never reach the image. The workflow in deploy-backend.yml builds
# from a git checkout, which has no .env because git ignores it, but a local
# build sends this folder as it is on disk, so the exclusion has to be repeated
# here or the key ends up in an image layer.
.env
.env.*
!.env.example

# Build and test artefacts: none are needed at runtime (the image installs with
# `uv sync --no-dev`) and they only inflate the upload.
.venv/
__pycache__/
*.pyc
.mypy_cache/
.pytest_cache/
.ruff_cache/
chromadb_data/
tests/
