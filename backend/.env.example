# GitHub token for repo ingestion and GitHub API calls.
# Optional: without it the app serves the local knowledge base only.
GITHUB_TOKEN=ghp_your_token_here

# Azure OpenAI / Azure AI Foundry endpoint and key
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
AZURE_OPENAI_API_KEY=your_azure_api_key_here
AZURE_OPENAI_API_VERSION=2024-10-21

# Azure model deployment names
LLM_MODEL=gpt-5-mini
EMBEDDING_MODEL=text-embedding-3-small

# Sampling temperature. Automatically omitted for gpt-5 / o-series deployments,
# which reject any non-default temperature with HTTP 400. Set
# LLM_SEND_TEMPERATURE=true/false to override that detection.
LLM_TEMPERATURE=0.3
# LLM_SEND_TEMPERATURE=false

# Cap on completion length. Sent as max_completion_tokens for gpt-5 / o-series,
# as max_tokens otherwise.
LLM_MAX_OUTPUT_TOKENS=1024

# Ask the provider to report token usage on streamed responses (logged, not
# shown to visitors). Set to false if a deployment rejects stream_options.
LLM_STREAM_USAGE=true

# Reasoning effort for gpt-5 / o-series deployments: minimal, low, medium or
# high, or empty to omit the parameter. Reasoning tokens are billed as output
# and are spent before the first visible token, so this drives both cost and
# time-to-first-token. Answering from retrieved context needs little
# deliberation. Ignored for non-reasoning models; an unrecognised value is
# dropped rather than sent.
LLM_REASONING_EFFORT=low

# GitHub username for API queries
GITHUB_USERNAME=DataScienceVishal

# CORS allowed origins (comma-separated) - the FRONTEND origins
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# Public origin of THIS api, used to build shareable links (resume download)
PUBLIC_BASE_URL=http://localhost:8000

# Rate limits. RATE_LIMIT is the loose default for cheap read-only endpoints,
# CHAT_RATE_LIMIT is the tight per-IP limit for /chat.
RATE_LIMIT=60/minute
CHAT_RATE_LIMIT=10/minute

# Global ceiling on chat completions per UTC day, across all visitors.
DAILY_CHAT_BUDGET=500

# Background ingestion of GitHub repos. Set to false to cut cold-start time
# and embedding cost.
INGEST_GITHUB=true
GITHUB_REPO_LIMIT=100
GITHUB_CONCURRENCY=5

# Repos never ingested (comma-separated, matched case-insensitively on the exact
# repo name). my-ai-resume is the retired V1 of this project: still public, but
# it should never appear as a citation.
GITHUB_EXCLUDE_REPOS=my-ai-resume

# Ingestion quality gates. Forks are not his own work, archived repos are dead,
# and GITHUB_REQUIRE_CONTENT drops repos with neither a description nor a
# README - nothing there is worth embedding, and they only add citation noise.
GITHUB_SKIP_FORKS=true
GITHUB_SKIP_ARCHIVED=true
GITHUB_REQUIRE_CONTENT=true

# ChromaDB persistence directory. Point at a mounted volume in production so
# the content-hash manifest survives restarts and documents are not re-embedded.
CHROMA_PERSIST_DIR=./chromadb_data

# Log level
LOG_LEVEL=info
